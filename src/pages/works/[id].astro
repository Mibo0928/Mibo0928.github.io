---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Article from '../../components/Article.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({ params: { id: work.id }, props: { work } }));
}
const { work } = Astro.props;
const { Content } = await render(work);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={work.data.title} description={work.data.summary} current="works">
  <Article
    title={work.data.title}
    date={work.data.date}
    placeholder={work.data.placeholder}
    back={{ href: `${base}/`, label: '回到房間' }}
  >
    <div slot="meta" class="meta">
      <p>{work.data.summary}</p>
      <ul class="tech" aria-label="使用的技術">{work.data.tech.map((t) => <li>{t}</li>)}</ul>
      {(work.data.demo || work.data.repo) && (
        <p class="links">
          {work.data.demo && <a href={work.data.demo}>看展示 <Icon name="external" size={16} /></a>}
          {work.data.repo && <a href={work.data.repo}>看原始碼 <Icon name="code" size={16} /></a>}
        </p>
      )}
    </div>
    {work.data.cover && (
      <Image src={work.data.cover} alt={work.data.coverAlt ?? ''} loading="eager" fetchpriority="high" />
    )}
    <Content />
  </Article>
</Base>

<style>
  .meta {
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-4);
    color: var(--ink-soft);
  }
  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tech li {
    font-size: 0.8125rem;
    line-height: 1;
    padding: 0.45em 0.75em;
    border-radius: 999px;
    background: var(--moss);
    color: var(--sage-deep);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    color: var(--ink);
  }
</style>
