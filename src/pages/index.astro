---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Room, { type RoomWork } from '../components/Room.astro';
import Icon from '../components/Icon.astro';
import site from '../site.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const works = (await getCollection('works')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const diary = (await getCollection('diary')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 每個房間物件只放一件作品（先到先放，依日期新到舊）
const taken = new Set<string>();
const roomWorks: RoomWork[] = [];
for (const w of works) {
  const slot = w.data.roomObject;
  if (!slot || taken.has(slot)) continue;
  taken.add(slot);
  roomWorks.push({
    id: w.id,
    title: w.data.title,
    href: `${base}/works/${w.id}/`,
    tech: w.data.tech,
    year: w.data.date.getFullYear(),
    slot,
    placeholder: w.data.placeholder,
  });
}

const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const moodLabel: Record<string, string> = { sunny: '晴天', cloudy: '陰天', rainy: '下雨', partly: '晴時多雲' };
const weather = (['sunny', 'cloudy', 'rainy', 'partly'] as const).find((w) => w === site.mood.weather) ?? 'sunny';
const latest = diary.slice(0, 3);
---

<Base current="home">
  <section class="home wrap" aria-labelledby="site-name">
    <div class="intro">
      <h1 id="site-name">{site.name}</h1>
      <p class="lede">{site.intro}</p>
      <p class="hint">
        <Icon name="arrow" size={16} />
        點房間裡的東西，看那件作品。
        <a class="list-link" href="#works">或直接看作品清單</a>
      </p>
    </div>

    <div class="room-wrap">
      <h2 class="visually-hidden">我的房間（作品）</h2>
      <Room works={roomWorks} />
    </div>

    <aside class="side" aria-label="心情與日記">
      <div class="panel mood">
        <p class="panel-head">今日心情</p>
        <div class="mood-body">
          <span class={`mood-icon is-${weather}`}><Icon name={weather} size={40} /></span>
          <div>
            <p class="mood-word">
              {moodLabel[weather]}
              {site.mood.placeholder && <span class="sample">範例</span>}
            </p>
            <p>{site.mood.text}</p>
          </div>
        </div>
      </div>

      <div class="panel diary">
        <h2 class="panel-head">
          <Icon name="diary" size={18} />
          最近的日記
        </h2>
        {latest.length === 0 ? (
          <p class="empty">還沒有日記。寫好第一篇之後，會出現在這裡。</p>
        ) : (
          <ol class="entries">
            {latest.map((e) => (
              <li>
                <a href={`${base}/diary/${e.id}/`}>
                  <span class="entry-title">
                    {e.data.title}
                    {e.data.placeholder && <span class="sample">範例</span>}
                  </span>
                  {e.data.excerpt && <span class="entry-excerpt">{e.data.excerpt}</span>}
                  <time datetime={e.data.date.toISOString().slice(0, 10)}>{fmt(e.data.date)}</time>
                </a>
              </li>
            ))}
          </ol>
        )}
        <a class="more" href={`${base}/diary/`}>
          全部日記
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </aside>
  </section>

  <section id="works" class="works wrap" aria-labelledby="works-title">
    <div class="section-head">
      <h2 id="works-title">作品清單</h2>
      <p>{works.length} 件作品，新的在前面。</p>
    </div>
    {works.length === 0 ? (
      <p class="empty">還沒有作品。在 src/content/works/ 放一個 .md 檔就會出現。</p>
    ) : (
      <ol class="work-list">
        {works.map((w) => (
          <li class="work">
            <time class="work-year" datetime={w.data.date.toISOString().slice(0, 10)}>{w.data.date.getFullYear()}</time>
            <div class="work-main">
              <h3>
                <a href={`${base}/works/${w.id}/`}>{w.data.title}</a>
                {w.data.placeholder && <span class="sample">範例</span>}
              </h3>
              <p>{w.data.summary}</p>
            </div>
            <ul class="tech" aria-label="使用的技術">
              {w.data.tech.map((t) => <li>{t}</li>)}
            </ul>
            <div class="work-links">
              {w.data.demo && (
                <a href={w.data.demo}>
                  展示 <Icon name="external" size={15} />
                </a>
              )}
              {w.data.repo && (
                <a href={w.data.repo}>
                  原始碼 <Icon name="code" size={15} />
                </a>
              )}
            </div>
          </li>
        ))}
      </ol>
    )}
  </section>

  <section class="about wrap" aria-labelledby="about-title">
    <h2 id="about-title">關於我</h2>
    <p>{site.about}</p>
  </section>
</Base>

<style>
  .home {
    display: grid;
    grid-template-columns: minmax(0, 2.1fr) minmax(18rem, 1fr);
    grid-template-areas:
      'intro side'
      'room side';
    column-gap: var(--space-7);
    align-items: start;
    padding-top: var(--space-2);
  }

  .intro {
    grid-area: intro;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-6);
    align-items: end;
  }

  h1 {
    grid-row: span 2;
    font-size: clamp(2.75rem, 1.6rem + 3.2vw, 4.75rem);
    letter-spacing: 0.02em;
    line-height: 1.05;
    color: var(--ink);
  }

  .lede {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--ink-soft);
    max-width: 26em;
  }

  .hint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-2);
    margin-top: var(--space-2);
    color: var(--sage-deep);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .list-link {
    margin-left: var(--space-3);
    color: var(--ink-soft);
  }

  .room-wrap {
    grid-area: room;
    max-width: 780px;
    width: 100%;
    justify-self: center;
    margin-top: var(--space-2);
  }

  .side {
    grid-area: side;
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-2);
  }

  .panel {
    background: var(--porcelain);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-l);
    padding: var(--space-4) var(--space-5) var(--space-5);
    box-shadow: var(--shadow-soft);
  }

  .panel-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
    background: radial-gradient(circle, var(--line) 1px, transparent 1.5px) 0 100% / 8px 2px repeat-x;
  }

  .mood-body {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    line-height: 1.6;
  }

  .mood-word {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.5rem;
    line-height: 1.3;
  }

  .mood-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background: var(--rain-soft);
    color: var(--rain-deep);
  }

  .mood-icon.is-sunny {
    background: #fbefd2;
    color: var(--acorn);
  }

  .diary {
    background: var(--blush-soft);
    border-color: var(--blush);
  }

  .diary .panel-head {
    color: var(--blush-deep);
    background-image: radial-gradient(circle, var(--blush) 1px, transparent 1.5px);
  }

  .entries {
    list-style: none;
    margin: 0 calc(var(--space-3) * -1);
    padding: 0;
  }

  .entries li + li {
    background: radial-gradient(circle, var(--blush) 1px, transparent 1.5px) 0 0 / 8px 2px repeat-x;
    padding-top: 2px;
  }

  .entries a {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3);
    border-radius: var(--radius-m);
    text-decoration: none;
    transition: background 0.25s var(--ease-out);
  }

  .entries a:hover {
    background: rgb(255 250 241 / 0.75);
  }

  .entry-title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  .entry-excerpt {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .entries time {
    font-size: 0.8125rem;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-4);
    font-size: 0.9375rem;
    color: var(--blush-deep);
    text-decoration-color: var(--blush);
  }

  .empty {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  /* 作品清單 */
  .works {
    padding-top: var(--space-9);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .section-head h2,
  .about h2 {
    font-size: clamp(1.75rem, 1.3rem + 1.2vw, 2.5rem);
  }

  .section-head p {
    color: var(--ink-faint);
    font-size: 0.9375rem;
  }

  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    --dots: radial-gradient(circle, var(--acorn) 1.1px, transparent 1.6px) 0 100% / 9px 3px repeat-x;
    background: radial-gradient(circle, var(--acorn) 1.1px, transparent 1.6px) 0 0 / 9px 3px repeat-x;
  }

  .work {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) minmax(0, 14rem) 9rem;
    gap: var(--space-5);
    align-items: baseline;
    padding-block: var(--space-5);
    background: var(--dots);
  }

  .work-year {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--acorn);
    font-variant-numeric: tabular-nums;
  }

  .work h3 {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-weight: 700;
    font-size: 1.375rem;
  }

  .work h3 a {
    text-decoration: none;
  }

  .work h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--sage);
  }

  .work-main p {
    margin-top: var(--space-1);
    color: var(--ink-soft);
    max-width: 40em;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tech li {
    font-size: 0.8125rem;
    line-height: 1;
    padding: 0.4em 0.7em;
    border-radius: 999px;
    background: var(--moss);
    color: var(--sage-deep);
  }

  .work-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-4);
    font-size: 0.9375rem;
  }

  .work-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
  }

  .about {
    padding-top: var(--space-8);
  }

  .about p {
    margin-top: var(--space-4);
    max-width: 36em;
    font-size: 1.125rem;
    color: var(--ink-soft);
  }

  @media (max-width: 1180px) {
    .home {
      grid-template-columns: minmax(0, 1.5fr) minmax(17rem, 1fr);
      grid-template-areas:
        'intro intro'
        'room side';
    }
  }

  @media (max-width: 820px) {
    .home {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'intro' 'room' 'side';
      row-gap: var(--space-5);
    }
    .intro {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-4);
    }
    h1 {
      grid-row: auto;
    }
    .list-link {
      margin-left: 0;
    }
    .work {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      gap: var(--space-2) var(--space-4);
    }
    .tech,
    .work-links {
      grid-column: 2;
      justify-content: flex-start;
    }
    .works {
      padding-top: var(--space-8);
    }
  }
</style>
