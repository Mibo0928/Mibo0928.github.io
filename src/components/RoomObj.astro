---
// 房間裡的一個物件。整張房間圖對螢幕閱讀器是隱藏的，所以這裡不放連結：
// 有分配到作品的物件只是「用滑鼠點也能進作品頁」的捷徑（由 Room.astro 的小程式處理），
// 鍵盤和螢幕閱讀器使用者用的是旁邊的名牌連結，兩者連到同一頁。
interface Props {
  slot: string;
  work?: { href: string; title: string };
  i: number;
}
const { slot, work, i } = Astro.props;
---

<g
  class:list={['obj', work ? 'obj-link' : 'obj-decor']}
  data-slot={slot}
  data-href={work?.href}
  style={`--i:${i}`}
>
  <slot />
</g>
