---
// 作品清單：首頁下方和「作品」頁共用。新增作品時兩邊會一起更新。
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  works: CollectionEntry<'works'>[];
  /** 作品名稱用哪一層標題：首頁在「作品清單」(h2) 底下用 h3；作品頁在 h1 底下用 h2 */
  itemHeading?: 'h2' | 'h3';
}
const { works, itemHeading = 'h3' } = Astro.props;
const Heading = itemHeading;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{works.length === 0 ? (
  <p class="empty">還沒有作品。在 src/content/works/ 放一個 .md 檔就會出現。</p>
) : (
  <ol class="work-list">
    {works.map((w) => (
      <li class="work">
        <time class="work-year" datetime={w.data.date.toISOString().slice(0, 10)}>{w.data.date.getFullYear()}</time>
        <div class="work-main">
          <Heading class="work-title">
            <a href={`${base}/works/${w.id}/`}>{w.data.title}</a>
            {w.data.placeholder && <span class="sample">範例</span>}
          </Heading>
          <p>{w.data.summary}</p>
        </div>
        <ul class="tech" aria-label="使用的技術">
          {w.data.tech.map((t) => <li>{t}</li>)}
        </ul>
        <div class="work-links">
          {w.data.demo && (
            <a href={w.data.demo}>
              展示 <Icon name="external" size={15} />
            </a>
          )}
          {w.data.repo && (
            <a href={w.data.repo}>
              原始碼 <Icon name="code" size={15} />
            </a>
          )}
        </div>
      </li>
    ))}
  </ol>
)}

<style>
  .empty {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    --dots: radial-gradient(circle, var(--acorn) 1.1px, transparent 1.6px) 0 100% / 9px 3px repeat-x;
    background: radial-gradient(circle, var(--acorn) 1.1px, transparent 1.6px) 0 0 / 9px 3px repeat-x;
  }

  .work {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) minmax(0, 14rem) 9rem;
    gap: var(--space-5);
    align-items: baseline;
    padding-block: var(--space-5);
    background: var(--dots);
  }

  .work-year {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--acorn);
    font-variant-numeric: tabular-nums;
  }

  .work-title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-weight: 700;
    font-size: 1.375rem;
  }

  .work-title a {
    text-decoration: none;
  }

  .work-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--sage);
  }

  .work-main p {
    margin-top: var(--space-1);
    color: var(--ink-soft);
    max-width: 40em;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tech li {
    font-size: 0.8125rem;
    line-height: 1;
    padding: 0.4em 0.7em;
    border-radius: 999px;
    background: var(--moss);
    color: var(--sage-deep);
  }

  .work-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-4);
    font-size: 0.9375rem;
  }

  .work-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
  }

  @media (max-width: 820px) {
    .work {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      gap: var(--space-2) var(--space-4);
    }
    .tech,
    .work-links {
      grid-column: 2;
      justify-content: flex-start;
    }
  }
</style>
